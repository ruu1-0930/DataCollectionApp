    "PressureAggregateV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "nonzero_mean_v1"
          ]
        },
        "unit": {
          "const": "ADC"
        },
        "threshold_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "left": {"$ref": "#/$defs/PressureSideV1"},
        "right": {"$ref": "#/$defs/PressureSideV1"},
        "matched_sensors": {"$ref": "#/$defs/PressureMatchedSensorsV1"},
        "matched_sensor_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "left_load_proxy_adc_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        },
        "right_load_proxy_adc_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
