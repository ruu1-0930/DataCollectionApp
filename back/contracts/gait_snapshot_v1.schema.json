            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "metric_id": {
                "const": "stride_time_cv_pct"
              }
            },
            "required": [
              "metric_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
