{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarcogait.local/contracts/gait_snapshot_v1.schema.json",
  "title": "Gait snapshot v1 provider contracts",
  "description": "Strict B snapshot and projection DTOs. Six-decimal DTO scalars do not truncate raw fingerprint source values. UTC timestamps serialize to exactly milliseconds; database event/ingest bounds may preserve microseconds.",
  "$defs": {
    "Decimal6": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
      "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
    },
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "TimestampUTC": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "StatisticsV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "mean_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        },
        "median_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        },
        "std_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        },
        "cv_pct_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "n",
        "mean_decimal",
        "median_decimal",
        "std_decimal",
        "cv_pct_decimal"
      ]
    },
    "MetricEvidenceV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "metric_id": {
          "type": "string",
          "enum": [
            "walking_speed_mps",
            "step_length_m",
            "single_support_time_s",
            "double_support_time_s",
            "cadence_spm",
            "step_length_asymmetry_pct",
            "stride_time_cv_pct",
            "double_support_ratio_pct"
          ]
        },
        "value_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "enum": [
            "m/s",
            "m",
            "s",
            "steps/min",
            "%"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "firmware",
            "derived"
          ]
        },
        "left_value_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        },
        "right_value_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*|-[1-9][0-9]*)\\.[0-9]{6}$",
              "description": "Signed fixed-point decimal, exactly six fractional digits, no exponent or negative zero. Derived DTO display precision only; raw fingerprint must retain every consumed source value at original precision."
            },
            {
              "type": "null"
            }
          ]
        },
        "statistics": {
          "$ref": "#/$defs/StatisticsV1"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_level": {
          "type": "string",
          "enum": [
            "clinical_reference",
            "exploratory",
            "firmware_measurement",
            "insufficient"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "evidence_id",
        "metric_id",
        "value_decimal",
        "unit",
        "source",
        "left_value_decimal",
        "right_value_decimal",
        "statistics",
        "formula",
        "source_field",
        "evidence_level",
        "reason_codes"
      ],
      "oneOf": [
        {
          "properties": {
            "metric_id": {
              "const": "walking_speed_mps"
            },
            "unit": {
              "const": "m/s"
            },
            "source": {
              "const": "firmware"
            },
            "formula": {
              "type": "null"
            },
            "source_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "properties": {
            "metric_id": {
              "const": "step_length_m"
            },
            "unit": {
              "const": "m"
            },
            "source": {
              "const": "firmware"
            },
            "formula": {
              "type": "null"
            },
            "source_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "properties": {
            "metric_id": {
              "const": "single_support_time_s"
            },
            "unit": {
              "const": "s"
            },
            "source": {
              "const": "firmware"
            },
            "formula": {
              "type": "null"
            },
            "source_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "properties": {
            "metric_id": {
              "const": "double_support_time_s"
            },
            "unit": {
              "const": "s"
            },
            "source": {
              "const": "firmware"
            },
            "formula": {
              "type": "null"
            },
            "source_field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        {
          "properties": {
            "metric_id": {
              "const": "cadence_spm"
            },
            "unit": {
              "const": "steps/min"
            },
            "source": {
              "const": "derived"
            },
            "formula": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source_field": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "metric_id": {
              "const": "step_length_asymmetry_pct"
            },
            "unit": {
              "const": "%"
            },
            "source": {
              "const": "derived"
            },
            "formula": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source_field": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "metric_id": {
              "const": "stride_time_cv_pct"
            },
            "unit": {
              "const": "%"
            },
            "source": {
              "const": "derived"
            },
            "formula": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source_field": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "metric_id": {
              "const": "double_support_ratio_pct"
            },
            "unit": {
              "const": "%"
            },
            "source": {
              "const": "derived"
            },
            "formula": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "source_field": {
              "type": "null"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value_decimal": {
                "type": "null"
              }
            },
            "required": [
              "value_decimal"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "Canonical metric units/source are bound to metric_id; null value requires a quality reason."
    },
    "Metrics8": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/MetricEvidenceV1"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "metric_id": {
                "const": "walking_speed_mps"
              }
            },
            "required": [
              "metric_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "metric_id": {
                "const": "step_length_m"
              }
            },
            "required": [
              "metric_id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
