{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contracts": {
    "ManagementScopeV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "capture",
            "legacy_session",
            "patient"
          ]
        },
        "patient_id": {
          "type": "integer",
          "minimum": 1
        },
        "record_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "patient_id",
        "record_id"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "patient"
              }
            }
          },
          "then": {
            "properties": {
              "record_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      ]
    },
    "DeletePreviewV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preview_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "capture",
                "legacy_session",
                "patient"
              ]
            },
            "patient_id": {
              "type": "integer",
              "minimum": 1
            },
            "record_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "patient_id",
            "record_id"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "patient"
                  }
                }
              },
              "then": {
                "properties": {
                  "record_id": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "record_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          ]
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "extra_affected_results": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "pending_upload": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "uniqueItems": true
        },
        "session_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        },
        "agent_state": {
          "enum": [
            "pending",
            "ready",
            "busy",
            "unavailable"
          ]
        },
        "agent_inventory_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "preview_id",
        "scope",
        "scope_hash",
        "source_versions",
        "counts",
        "extra_affected_results",
        "pending_upload",
        "expires_at",
        "snapshot_ids",
        "session_ids",
        "agent_state",
        "agent_inventory_hash",
        "operation_id"
