{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capture registration v1",
  "$ref": "#/$defs/CaptureRegistrationV1",
  "$defs": {
    "CaptureRegistrationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "patient_id", "patient_snapshot", "test_type", "remarks"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "patient_id": {"type": "integer", "minimum": 1},
        "patient_snapshot": {"$ref": "#/$defs/PatientSnapshotV1"},
        "test_type": {"enum": ["static_standing", "walk_10m_usual", "five_times_sit_to_stand", "tug", "free_capture"]},
        "remarks": {"type": "string", "maxLength": 2000}
      }
    },
    "PatientSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gender", "age", "height_cm", "weight_kg", "shoe_size_eu"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 50},
        "gender": {"enum": ["男", "女"]},
        "age": {"type": "integer", "minimum": 0, "maximum": 150},
        "height_cm": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "weight_kg": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
        "shoe_size_eu": {"type": "number", "exclusiveMinimum": 0, "maximum": 100, "multipleOf": 0.5}
      }
    }
  }
}
