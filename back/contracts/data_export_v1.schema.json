{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contracts": {
    "BundleRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "patient_id",
        "scope",
        "record_ids",
        "mode",
        "contents"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "patient_id": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "enum": [
            "records",
            "patient"
          ]
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(P[1-9][0-9]*-[0-9]{8}T[0-9]{12}|[0-9a-f-]{36})$"
          },
          "uniqueItems": true
        },
        "mode": {
          "enum": [
            "backup",
            "export"
          ]
        },
        "contents": {
          "type": "array",
          "items": {
            "enum": [
              "profiles",
              "raw",
              "analysis",
              "agent"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "patient"
              }
            }
          },
          "then": {
            "properties": {
              "record_ids": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "record_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "backup"
              }
            }
          },
          "then": {
            "properties": {
              "contents": {
                "minItems": 4
              }
            }
          }
        }
      ]
    },
    "BundleReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle_id",
        "patient_id",
        "mode",
        "state",
        "error_code",
        "created_at",
        "expires_at",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "patient_id": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "export",
            "backup"
          ]
        },
        "state": {
          "enum": [
            "building",
            "ready",
            "failed",
            "expired"
          ]
        },
        "error_code": {
          "type": [
            "null",
            "string"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "size_bytes": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": 0
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DownloadGrantV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "bundle_id",
        "grant",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "grant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
