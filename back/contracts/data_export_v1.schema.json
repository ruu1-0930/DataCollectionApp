        "mode": {
          "enum": [
            "export",
            "backup"
          ]
        },
        "state": {
          "enum": [
            "building",
            "ready",
            "failed",
            "expired"
          ]
        },
        "error_code": {
          "type": [
            "null",
            "string"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "size_bytes": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": 0
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
